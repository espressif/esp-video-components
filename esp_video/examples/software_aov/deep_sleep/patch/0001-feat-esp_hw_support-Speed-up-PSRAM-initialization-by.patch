diff --git a/components/esp_hw_support/mspi_timing_tuning/tuning_scheme_impl/mspi_timing_psram_cache.c b/components/esp_hw_support/mspi_timing_tuning/tuning_scheme_impl/mspi_timing_psram_cache.c
new file mode 100644
index 00000000000..70ae3e29a29
--- /dev/null
+++ b/components/esp_hw_support/mspi_timing_tuning/tuning_scheme_impl/mspi_timing_psram_cache.c
@@ -0,0 +1,76 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "sdkconfig.h"
+#include "esp_attr.h"
+#include "esp_rom_sys.h"
+#include "soc/reset_reasons.h"
+#include "esp_private/mspi_timing_psram_cache.h"
+
+#if CONFIG_SPIRAM_TIMING_TUNING_CACHE_IN_RTC
+
+#define MSPI_TIMING_PSRAM_CACHE_MAGIC   0x50535443  // 'PSTC'
+#define MSPI_TIMING_PSRAM_CACHE_VERSION 1
+
+typedef struct {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t fingerprint;
+    mspi_timing_psram_cache_params_t params;
+} mspi_timing_psram_cache_t;
+
+static RTC_NOINIT_ATTR mspi_timing_psram_cache_t s_psram_timing_cache;
+
+static uint32_t s_get_config_fingerprint(void)
+{
+    return ((uint32_t)CONFIG_SPIRAM_SPEED)
+#if CONFIG_SPIRAM_MODE_OCT
+           | (1u << 8)
+#elif CONFIG_SPIRAM_MODE_HEX
+           | (2u << 8)
+#elif CONFIG_SPIRAM_MODE_QUAD
+           | (3u << 8)
+#endif
+           ;
+}
+
+static bool s_is_cache_valid(const mspi_timing_psram_cache_t *cache)
+{
+    return cache->magic == MSPI_TIMING_PSRAM_CACHE_MAGIC
+           && cache->version == MSPI_TIMING_PSRAM_CACHE_VERSION
+           && cache->fingerprint == s_get_config_fingerprint()
+           && (cache->params.scheme == MSPI_TIMING_PSRAM_CACHE_SCHEME_MSPI_DELAY
+               || cache->params.scheme == MSPI_TIMING_PSRAM_CACHE_SCHEME_DQS);
+}
+
+static bool s_is_deep_sleep_wakeup(void)
+{
+    return esp_rom_get_reset_reason(0) == RESET_REASON_CORE_DEEP_SLEEP;
+}
+
+bool mspi_timing_psram_cache_try_restore(void)
+{
+    if (!s_is_deep_sleep_wakeup() || !s_is_cache_valid(&s_psram_timing_cache)) {
+        return false;
+    }
+
+    mspi_timing_psram_import_best_params(&s_psram_timing_cache.params);
+    return true;
+}
+
+void mspi_timing_psram_cache_save(void)
+{
+    mspi_timing_psram_cache_t cache = {
+        .magic = MSPI_TIMING_PSRAM_CACHE_MAGIC,
+        .version = MSPI_TIMING_PSRAM_CACHE_VERSION,
+        .fingerprint = s_get_config_fingerprint(),
+    };
+
+    mspi_timing_psram_export_best_params(&cache.params);
+    s_psram_timing_cache = cache;
+}
+
+#endif // CONFIG_SPIRAM_TIMING_TUNING_CACHE_IN_RTC
diff --git a/components/esp_psram/Kconfig.spiram.common b/components/esp_psram/Kconfig.spiram.common
index ac60dec87f3..6b3d971504a 100644
--- a/components/esp_psram/Kconfig.spiram.common
+++ b/components/esp_psram/Kconfig.spiram.common
@@ -195,3 +195,21 @@ config SPIRAM_ENC_EXEMPT_SIZE
         of the MMU page size (typically 64 KB).
         The region is registered as a separate heap pool, accessible only via
         MALLOC_CAP_SPIRAM_NO_ENC.
+
+config SPIRAM_TIMING_TUNING_CACHE_IN_RTC
+    bool "Cache PSRAM MSPI timing tuning results in RTC memory"
+    default n
+    depends on SPIRAM && (SOC_MEMSPI_TIMING_TUNING_BY_MSPI_DELAY || SOC_MEMSPI_TIMING_TUNING_BY_DQS) \
+        && (SOC_RTC_FAST_MEM_SUPPORTED || SOC_RTC_SLOW_MEM_SUPPORTED)
+    help
+        When enabled, PSRAM MSPI timing tuning results are stored in RTC noinit
+        memory after a successful tuning run. On subsequent wake-up from deep sleep,
+        the cached parameters are restored directly and the tuning procedure is
+        skipped to reduce boot time.
+
+        The cache is validated using a magic number and the current PSRAM speed/mode
+        configuration. If validation fails, tuning is performed again and the cache
+        is updated.
+
+        Note: RTC noinit memory is retained across deep sleep wake-up, but not
+        guaranteed across power-on reset.
