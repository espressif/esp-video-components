CONFIG_EXAMPLE_ENABLE_MIPI_CSI_CAM_IRCUT=y
CONFIG_EXAMPLE_MIPI_CSI_CAM_IRCUT_FBC_PIN=46
CONFIG_EXAMPLE_ENABLE_MIPI_CSI_CAM_LED=y
CONFIG_EXAMPLE_MIPI_CSI_CAM_LED_CTRL_PIN=48

CONFIG_CAMERA_SC2337P=y
CONFIG_CAMERA_SC2337P_MIPI_RAW10_1088X1080_30FPS=n
CONFIG_CAMERA_SC2337P_MIPI_RAW8_1920X1080_30FPS=y
CONFIG_CAMERA_SC2337P_IR_IPA_JSON_CONFIGURATION_FILE=y

CONFIG_CAM_IRCUT_AP1511B=y
CONFIG_CAM_LED_IR2835=y

CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_IRCUT_SUPPORT=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_LED_SUPPORT=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=n
