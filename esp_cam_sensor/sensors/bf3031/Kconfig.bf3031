menuconfig CAMERA_BF3031
    bool "BF3031"
    default n
    depends on SOC_LCDCAM_CAM_SUPPORTED
    help
        Enable support for the BF3031 CMOS image sensor.

if CAMERA_BF3031
    menu "Auto detect BF3031"
        config CAMERA_BF3031_AUTO_DETECT_DVP_INTERFACE_SENSOR
            bool "Detect for DVP interface sensor"
            default y
            help
                When enabled, the BF3031 sensor will be automatically detected
                and initialized on the DVP interface at startup without requiring
                manual detection call(bf3031_detect) in your application.
    endmenu

    config CAMERA_BF3031_SID_HIGH
        bool "Set SID pin to high"
        default n
        help
            This option allows you to configure the sensor ID. When the SID pin uses a high level, 
            the sensor ID will be configured as 0x6d, otherwise, the sensor ID will be configured as 0x6e.

    menu "Choose supported formats for DVP interface"
        config CAMERA_BF3031_DVP_YUV422_838X640_25FPS
            bool "DVP 8-bit, 20M input, 838x640 25fps, YUV422"
            default y
            help
                Standard color format using YUV422 at 838x640 resolution
                with 25fps framerate. Requires 8-bit DVP interface and 20MHz input.
    endmenu

    choice CAMERA_BF3031_DVP_DEFAULT_FMT
        prompt "Select default output format for DVP interface"
        default CAMERA_BF3031_DVP_DEFAULT_FMT_YUV422_838X640_25FPS
        help
            This is an internal choice that ensures only one format can be selected as default.
            It is automatically controlled by the "Set as default format" options above.

        config CAMERA_BF3031_DVP_DEFAULT_FMT_YUV422_838X640_25FPS
            bool "DVP 8-bit, 20M input, 838x640 25fps, YUV422"
            depends on CAMERA_BF3031_DVP_YUV422_838X640_25FPS
    endchoice # CAMERA_BF3031_DVP_DEFAULT_FMT

    config CAMERA_BF3031_DVP_IF_FORMAT_INDEX_DEFAULT
        int
        default 0 if CAMERA_BF3031_DVP_DEFAULT_FMT_YUV422_838X640_25FPS
        help
            Sets the default configuration for the DVP interface.
            Use query_support_formats() API to get more format options.
endif
